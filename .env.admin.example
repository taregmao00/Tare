# Copier ce fichier en .env.admin (jamais envoyé sur GitHub) : il ne sert qu'aux commandes
# « npm run demo » et « npm run diagnostic », lancées sur le PC. L'appli ne le lit jamais.
# NE PAS mettre ces deux valeurs dans Vercel, ni dans .env.local.

# Clé SECRÈTE du projet tare-dev : Supabase → Project Settings → API Keys → « Secret key ».
# Elle donne tous les droits sur la base : ne jamais la coller dans une conversation ni dans le code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Mot de passe commun des 4 comptes de démonstration (à inventer, 8 caractères au moins).
DEMO_MOT_DE_PASSE=
